global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: 15s
  external_labels:
    cluster: prometheus-cluster
    replica: "{{ replica_name | default('unknown') }}"

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "redis_exporter"
    static_configs:
      - targets:
          - "redis-server-1:1394"
          - "redis-server-2:1394"
          - "redis-server-3:1394"

          